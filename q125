#include <stdio.h>
int main() {
    char name[50];
    int age;
    FILE *fptr = fopen("info.txt", "w");
    if (fptr == NULL) {
        printf("Error opening file!\n");
        return 1;
    }
    printf("Enter your name: ");
    scanf("%s", name);
    printf("Enter your age: ");
    scanf("%d", &age);
    fprintf(fptr, "Name: %s\nAge: %d\n", name, age);
    fclose(fptr);
    printf("Data was successfully saved to info.txt.\n");
    return 0;
}
